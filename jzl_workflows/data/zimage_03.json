sLabel","pos":[1480,-50],"size":[2406,177],"flags":{"allow_interaction":false,"pinned":true},"order":4,"mode":0,"inputs":[],"outputs":[],"title":"Z-Image-Base 文生图基础工作流","properties":{"cnr_id":"XB_ToolBox","ver":"29874f0b0e43b035f2b06d0e4968587c70cbd351","Node name for S&R":"XB_CanvasLabel","fontSize":163,"fontColor":"#ffffff","textAlign":"left","backgroundColor":"transparent","padding":0,"borderRadius":0,"angle":0,"aux_id":"wjluoxiao/XB_ToolBox"},"widgets_values":[""],"widgets_values_named":{"xb_label_view":""},"color":"transparent","bgcolor":"transparent"},{"id":81,"type":"MarkdownNote","pos":[860,280],"size":[580,830],"flags":{"pinned":true},"order":5,"mode":0,"inputs":[],"outputs":[],"title":"工作流说明书","properties":{"ue_properties":{"widget_ue_connectable":{},"version":"7.7","input_ue_unconnectable":{}}},"widgets_values":["# Z-image 文生图工作流\n\n---\n\n# **🎬 工作流简介：** \n\n本工作流为最基础的文生图工作流，主模型为Z-Image_Turbo，主模型仓库提供有：FP8（小显存专用）、FP16（标准模型）、NSFW（男孩专属），可根据自己需求和配置切换模型！\n\n## **💻小白工具箱:** \n\n- [小白工具箱官方网站](https://github.com/wjluoxiao/XB_ToolBox)  ⬅️ 点击访问 ✅ \n\n## **📂模型传送门:** \n\n- [机制罗的模型总仓库](https://pan.quark.cn/s/6a56ffe475a6)  ⬅️ 点击访问 ✅\n\n## **🌟教程传送门:** \n\n-  [机制罗的保姆级教程](https://space.bilibili.com/302329373)  ⬅️ 点击访问 ✅\n\n---\n\n# 模型位置示意图 & 所需模型名称\n\n```\n📂 ComfyUI/\n├── 📂 models/\n│   ├── 📂 diffusion_models/\n│   │      └── Z-Image_Base.safetensors\n│   ├── 📂 clip/\n│   │      └── qwen_3_4b_fp8_mixed.safetensors\n│   ├── 📂 vae/\n│   │      └── ae.safetensors\n│   └── 📂 loras/ \n│          └── Zimage_lora.safetensors\n```\n\n\n---\n## **📝模型说明书:** \n\n**Z-Image_Base:** 2026 年初由阿里巴巴通义万相团队（独立于 Wan 视频团队）推出的重磅超快速文生图模型。是目前平衡美学表现力与部署灵活性的标杆架构。\n\nZ-Image Base (ZIB) 代表了该系列模型的“全血状态”。如果说 Z-Image Turbo 是为了追求极限速度的“快照”，那么 Base 模型 就是为了追求极致画质与物理逻辑的“暗房底片”。适合用来“搞艺术”和“做工程”的话，它的构图稳定性比 Turbo 强了几个维度。\n\n---\n推荐CFG：3.0-5.0\n\n推荐步数：30-50\n\n推荐采样器：euler \n\n推荐调度器：simple\n\n推荐采样偏移：3.0~10.0，按分辨率调整。   \n\n---\n"],"widgets_values_named":{"text":"# Z-image 文生图工作流\n\n---\n\n# **🎬 工作流简介：** \n\n本工作流为最基础的文生图工作流，主模型为Z-Image_Turbo，主模型仓库提供有：FP8（小显存专用）、FP16（标准模型）、NSFW（男孩专属），可根据自己需求和配置切换模型！\n\n## **💻小白工具箱:** \n\n- [小白工具箱官方网站](https://github.com/wjluoxiao/XB_ToolBox)  ⬅️ 点击访问 ✅ \n\n## **📂模型传送门:** \n\n- [机制罗的模型总仓库](https://pan.quark.cn/s/6a56ffe475a6)  ⬅️ 点击访问 ✅\n\n## **🌟教程传送门:** \n\n-  [机制罗的保姆级教程](https://space.bilibili.com/302329373)  ⬅️ 点击访问 ✅\n\n---\n\n# 模型位置示意图 & 所需模型名称\n\n```\n📂 ComfyUI/\n├── 📂 models/\n│   ├── 📂 diffusion_models/\n│   │      └── Z-Image_Base.safetensors\n│   ├── 📂 clip/\n│   │      └── qwen_3_4b_fp8_mixed.safetensors\n│   ├── 📂 vae/\n│   │      └── ae.safetensors\n│   └── 📂 loras/ \n│          └── Zimage_lora.safetensors\n```\n\n\n---\n## **📝模型说明书:** \n\n**Z-Image_Base:** 2026 年初由阿里巴巴通义万相团队（独立于 Wan 视频团队）推出的重磅超快速文生图模型。是目前平衡美学表现力与部署灵活性的标杆架构。\n\nZ-Image Base (ZIB) 代表了该系列模型的“全血状态”。如果说 Z-Image Turbo 是为了追求极限速度的“快照”，那么 Base 模型 就是为了追求极致画质与物理逻辑的“暗房底片”。适合用来“搞艺术”和“做工程”的话，它的构图稳定性比 Turbo 强了几个维度。\n\n---\n推荐CFG：3.0-5.0\n\n推荐步数：30-50\n\n推荐采样器：euler \n\n推荐调度器：simple\n\n推荐采样偏移：3.0~10.0，按分辨率调整。   \n\n---\n"},"color":"#222","bgcolor":"#000"},{"id":82,"type":"XB_CanvasLabel","pos":[1020,160],"size":[288,66],"flags":{"allow_interaction":false,"pinned":true},"order":6,"mode":0,"inputs":[],"outputs":[],"title":"先看说明","properties":{"cnr_id":"XB_ToolBox","ver":"29874f0b0e43b035f2b06d0e4968587c70cbd351","Node name for S&R":"XB_CanvasLabel","fontSize":66,"fontColor":"#ffffff","textAlign":"left","backgroundColor":"transparent","padding":0,"borderRadius":0,"angle":0,"aux_id":"wjluoxiao/XB_ToolBox"},"widgets_values":[""],"widgets_values_named":{"xb_label_view":""},"color":"transparent","bgcolor":"transparent"},{"id":65,"type":"CLIPTextEncode","pos":[2000,400],"size":[490,360],"flags":{"pinned":true},"order":9,"mode":0,"inputs":[{"localized_name":"clip","name":"clip","type":"CLIP","link":90},{"localized_name":"文本","name":"text","type":"STRING","widget":{"name":"text"},"link":null}],"outputs":[{"localized_name":"条件","name":"CONDITIONING","type":"CONDITIONING","slot_index":0,"links":[76]}],"title":"CLIP Text Encode (Positive Prompt)","properties":{"cnr_id":"comfy-core","ver":"0.16.3","Node name for S&R":"CLIPTextEncode","ue_properties":{"widget_ue_connectable":{},"version":"7.7","input_ue_unconnectable":{}}},"widgets_values":["这是一幅高度写实、充满未来科技感的数字插画，描绘了一位身着赛车风格战斗装甲的女性角色。她拥有健康的小麦色肌肤，线条紧致的腹肌与腰线清晰可见，展现出极强的力量感与运动美感。她的棕色中长发自然垂落，部分被头盔遮挡，蓝色眼眸深邃锐利，直视观者，表情冷静而自信。\n\n她身穿一套以白色为主、搭配黑色与橙色点缀的紧身机甲战衣。上半身是露脐式设计，胸甲两侧饰有红色十字医疗标志，暗示其可能兼具救援或医疗职能。腰部系有一条宽大的黑色战术腰带，配有金属扣具和复杂机械结构。下装为高腰短裤，侧边印有醒目的橙色大写字母“JZL”，字体粗犷有力，明确指向B站著名UP主（机智罗）的品牌标识。腿部装备了带有护板与管线的机械外骨骼，强化了科幻战斗氛围。\n\n头部佩戴全覆式赛车头盔，镜片呈紫色反光，头盔侧面亦有红十字图案。她双臂抬起置于脑后，姿态放松却充满张力，仿佛刚结束一场激烈竞速或战斗。整体画风融合了日系动漫的精致人物比例与西方CG的光影质感，背景为纯白，突出主体，营造出干净、聚焦、充满动感的视觉效果。此角色虽无官方命名，但其造型与“JZL”字样强烈暗示其为某款游戏或动画中的原创机甲女战士形象。"],"widgets_values_named":{"text":"这是一幅高度写实、充满未来科技感的数字插画，描绘了一位身着赛车风格战斗装甲的女性角色。她拥有健康的小麦色肌肤，线条紧致的腹肌与腰线清晰可见，展现出极强的力量感与运动美感。她的棕色中长发自然垂落，部分被头盔遮挡，蓝色眼眸深邃锐利，直视观者，表情冷静而自信。\n\n她身穿一套以白色为主、搭配黑色与橙色点缀的紧身机甲战衣。上半身是露脐式设计，胸甲两侧饰有红色十字医疗标志，暗示其可能兼具救援或医疗职能。腰部系有一条宽大的黑色战术腰带，配有金属扣具和复杂机械结构。下装为高腰短裤，侧边印有醒目的橙色大写字母“JZL”，字体粗犷有力，明确指向B站著名UP主（机智罗）的品牌标识。腿部装备了带有护板与管线的机械外骨骼，强化了科幻战斗氛围。\n\n头部佩戴全覆式赛车头盔，镜片呈紫色反光，头盔侧面亦有红十字图案。她双臂抬起置于脑后，姿态放松却充满张力，仿佛刚结束一场激烈竞速或战斗。整体画风融合了日系动漫的精致人物比例与西方CG的光影质感，背景为纯白，突出主体，营造出干净、聚焦、充满动感的视觉效果。此角色虽无官方命名，但其造型与“JZL”字样强烈暗示其为某款游戏或动画中的原创机甲女战士形象。"},"color":"#232","bgcolor":"#353"},{"id":64,"type":"UNETLoader","pos":[1500,230],"size":[450,140],"flags":{"pinned":true},"order":7,"mode":0,"inputs":[{"localized_name":"UNet名称","name":"unet_name","type":"COMBO","widget":{"name":"unet_name"},"link":null},{"localized_name":"数据类型","name":"weight_dtype","type":"COMBO","widget":{"name":"weight_dtype"},"link":null}],"outputs":[{"localized_name":"模型","name":"MODEL","type":"MODEL","links":[91]}],"properties":{"cnr_id":"comfy-core","ver":"0.16.3","Node name for S&R":"UNETLoader","ue_properties":{"widget_ue_connectable":{},"version":"7.7","input_ue_unconnectable":{}}},"widgets_values":["Z-Image\\Z-Image_Base_bf16.safetensors","default"],"widgets_values_named":{"unet_name":"Z-Image\