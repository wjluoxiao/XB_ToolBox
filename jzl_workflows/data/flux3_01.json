{"id":"e8f30439-267f-45de-b260-db0d114b2c85","revision":0,"last_node_id":54,"last_link_id":121,"nodes":[{"id":9,"type":"SaveImage","pos":[1200,-370],"size":[810,880],"flags":{"pinned":true},"order":4,"mode":0,"inputs":[{"localized_name":"图片","name":"images","type":"IMAGE","link":93},{"localized_name":"文件名前缀","name":"filename_prefix","type":"STRING","widget":{"name":"filename_prefix"},"link":null}],"outputs":[{"localized_name":"images","name":"images","type":"IMAGE","links":null}],"properties":{"cnr_id":"comfy-core","ver":"0.41.3","Node name for S&R":"SaveImage"},"widgets_values":["图片/Flux3/文生图/Flux3文生图"],"widgets_values_named":{"filename_prefix":"图片/Flux3/文生图/Flux3文生图"},"color":"#223","bgcolor":"#335"},{"id":48,"type":"XB_ImagePromptPreset","pos":[0,-370],"size":[590,860],"flags":{"pinned":true},"order":0,"mode":0,"inputs":[{"localized_name":"空latent类型","name":"latent_kind","type":"COMBO","widget":{"name":"latent_kind"},"link":null},{"localized_name":"输出语言","name":"output_lang","type":"COMBO","widget":{"name":"output_lang"},"link":null},{"localized_name":"预设模式","name":"preset_mode","type":"COMBO","widget":{"name":"preset_mode"},"link":null},{"localized_name":"预设句（右上角按钮管理预设）","name":"three_view_text","type":"STRING","widget":{"name":"three_view_text"},"link":null},{"localized_name":"画幅比例","name":"aspect_ratio","type":"COMBO","widget":{"name":"aspect_ratio"},"link":null},{"localized_name":"宽度","name":"width","type":"INT","widget":{"name":"width"},"link":null},{"localized_name":"高度","name":"height","type":"INT","widget":{"name":"height"},"link":null},{"localized_name":"生成数量","name":"batch_size","type":"INT","widget":{"name":"batch_size"},"link":null}],"outputs":[{"localized_name":"提示词","name":"提示词","type":"STRING","links":[91]},{"localized_name":"空latent","name":"空latent","type":"LATENT","links":[92]}],"properties":{"cnr_id":"XB_ToolBox","ver":"35a6c6388058434d0b3a5cb64b39677726a729d5","Node name for S&R":"XB_ImagePromptPreset"},"widgets_values":["Flux3","中文 [ZH]","无预设","","1:1",1088,1088,1,"电影级特写镜头，微距摄影。一个身穿半透明哑光磨砂硅胶宇航服的年轻东亚女性机械师，正专注地凝视手中悬浮的微型机械核心。\n\n人物细节：\n面部皮肤具有真实的毛孔纹理与极其微弱的次表面散射质感，额角带有几颗晶莹细腻的汗珠；睫毛根根分明，眼眸倒映着复杂的蓝色全息数据流；发丝略微凌乱，有几缕碎发被静电吸附在头盔内壁。\n\n主体道具与流体：\n她双手托举着一个拳头大小、由黄铜与发黑钛合金构成的精密发条球形核心，核心内部多层齿轮正在咬合旋转，中央镶嵌着一颗散发着温润橙红色光芒的微型核反应晶石；从核心边缘溢出数滴处于零重力悬浮状态的水银液滴，水银表面呈现出完美的环境镜面反射与流体流动张力。\n\n文字与材质排版：\n在她宇航服左胸的钛合金铭牌上，清晰、锐利地雕刻着机械工业字体的中文“重力校准·07”与英文编号“REV-802”，边缘带有些许真实的金属磨损刮痕与细微氧化锈迹。\n\n光影与色彩：\n主光源为核心散发出的暖橙色点光源，自下而上勾勒出人物下颚与手指指尖的轮廓光；背景辅助光是赛博朋克深冷蓝色的微弱环境漫反射，形成鲜明的冷暖色调对冲；悬浮在空中的金属微尘颗粒捕捉到光线，产生柔和的光晕与丁达尔效应。\n\n镜头构图：\n浅景深，f/1.8，85mm人像镜头特写，焦点精准锁定在发条核心与人物的眼神之间，背景中废弃工业机舱的管道与电缆呈现出平滑自然的奶油般焦外虚化（Bokeh）。","",""],"widgets_values_named":{"latent_kind":"Flux3","output_lang":"中文 [ZH]","preset_mode":"无预设","three_view_text":"","aspect_ratio":"1:1","width":1088,"height":1088,"batch_size":1,"internal_prompt":"电影级特写镜头，微距摄影。一个身穿半透明哑光磨砂硅胶宇航服的年轻东亚女性机械师，正专注地凝视手中悬浮的微型机械核心。\n\n人物细节：\n面部皮肤具有真实的毛孔纹理与极其微弱的次表面散射质感，额角带有几颗晶莹细腻的汗珠；睫毛根根分明，眼眸倒映着复杂的蓝色全息数据流；发丝略微凌乱，有几缕碎发被静电吸附在头盔内壁。\n\n主体道具与流体：\n她双手托举着一个拳头大小、由黄铜与发黑钛合金构成的精密发条球形核心，核心内部多层齿轮正在咬合旋转，中央镶嵌着一颗散发着温润橙红色光芒的微型核反应晶石；从核心边缘溢出数滴处于零重力悬浮状态的水银液滴，水银表面呈现出完美的环境镜面反射与流体流动张力。\n\n文字与材质排版：\n在她宇航服左胸的钛合金铭牌上，清晰、锐利地雕刻着机械工业字体的中文“重力校准·07”与英文编号“REV-802”，边缘带有些许真实的金属磨损刮痕与细微氧化锈迹。\n\n光影与色彩：\n主光源为核心散发出的暖橙色点光源，自下而上勾勒出人物下颚与手指指尖的轮廓光；背景辅助光是赛博朋克深冷蓝色的微弱环境漫反射，形成鲜明的冷暖色调对冲；悬浮在空中的金属微尘颗粒捕捉到光线，产生柔和的光晕与丁达尔效应。\n\n镜头构图：\n浅景深，f/1.8，85mm人像镜头特写，焦点精准锁定在发条核心与人物的眼神之间，背景中废弃工业机舱的管道与电缆呈现出平滑自然的奶油般焦外虚化（Bokeh）。","manager_settings":"","xb_image_preset":""},"color":"#16727c","bgcolor":"#4F0074"},{"id":49,"type":"9a62c411-358c-4e5f-9ba2-8df17c69403a","pos":[620,-370],"size":[550,880],"flags":{"pinned":true},"order":3,"mode":0,"inputs":[{"localized_name":"提示词","name":"prompt","type":"STRING","link":91},{"localized_name":"Latent图像","name":"latent_image","type":"LATENT","link":92},{"label":"主模型","name":"unet_name","type":"COMBO","widget":{"name":"unet_name"},"link":null},{"label":"CLIP","name":"clip_name","type":"COMBO","widget":{"name":"clip_name"},"link":null},{"label":"VAE","name":"vae_na