nvas-image-preview"}]},"widgets_values":["图片/Qwen-image-2511/文生图/Qwen-2511",349045734328788,"euler","simple",4,1,640,32,"不做任何清理","一、背景替换\n将原背景替换为沉浸式欧式复古玫瑰花园：\n画面两侧及背景深处铺满层层盛放的红、粉、奶白三色重瓣玫瑰，翠绿叶片饱满鲜亮，花间点缀细碎观叶植物，一条浅灰色石板小径从人物身后蜿蜒延伸至花园深处，远景是修剪整齐的墨绿色树篱与朦胧的乔木树冠。午后暖金色阳光从左上方向柔和洒落，在花瓣、叶片上形成通透的自然高光，地面投下柔和的花叶阴影，空气中带有极淡的薄雾丁达尔效应，景深自然虚化，突出中心人物，整体氛围浪漫明媚，写实感强烈。\n二、广告级悬浮立体艺术字（替代生硬横幅）\n在画面下半区域、人物身前位置，悬浮一行巨型高端广告级 3D 立体艺术字，文字内容：机智罗 Qwen2511 工作流\n排版与字体：整行文字居中排布，字号巨大醒目，占据画面下方约 1/4 视觉宽度；中文采用厚重典雅的粗黑艺术字形，英文与数字采用现代简约粗无衬线体，字重均匀，笔画利落，整体视觉平衡协调。\n材质质感：字体主体为哑光奶白色基底，表面覆盖细腻的铂金光影渐变，笔画边缘镶嵌极细的鎏金描边，笔画转角与凸起处有自然的阳光高光反射，质感温润高级，无廉价塑料感。\n\n清晰度要求：所有文字笔画锐利清晰，无模糊、无乱码、无错位变形，中英文数字排版工整。","模糊，水印，多手指，五官变形，"],"widgets_values_named":{"filename_prefix":"图片/Qwen-image-2511/文生图/Qwen-2511","seed":349045734328788,"sampler_name":"euler","scheduler":"simple","steps":4,"cfg":1,"tile_size":640,"overlap":32,"cleanup":"不做任何清理","prompt":"一、背景替换\n将原背景替换为沉浸式欧式复古玫瑰花园：\n画面两侧及背景深处铺满层层盛放的红、粉、奶白三色重瓣玫瑰，翠绿叶片饱满鲜亮，花间点缀细碎观叶植物，一条浅灰色石板小径从人物身后蜿蜒延伸至花园深处，远景是修剪整齐的墨绿色树篱与朦胧的乔木树冠。午后暖金色阳光从左上方向柔和洒落，在花瓣、叶片上形成通透的自然高光，地面投下柔和的花叶阴影，空气中带有极淡的薄雾丁达尔效应，景深自然虚化，突出中心人物，整体氛围浪漫明媚，写实感强烈。\n二、广告级悬浮立体艺术字（替代生硬横幅）\n在画面下半区域、人物身前位置，悬浮一行巨型高端广告级 3D 立体艺术字，文字内容：机智罗 Qwen2511 工作流\n排版与字体：整行文字居中排布，字号巨大醒目，占据画面下方约 1/4 视觉宽度；中文采用厚重典雅的粗黑艺术字形，英文与数字采用现代简约粗无衬线体，字重均匀，笔画利落，整体视觉平衡协调。\n材质质感：字体主体为哑光奶白色基底，表面覆盖细腻的铂金光影渐变，笔画边缘镶嵌极细的鎏金描边，笔画转角与凸起处有自然的阳光高光反射，质感温润高级，无廉价塑料感。\n\n清晰度要求：所有文字笔画锐利清晰，无模糊、无乱码、无错位变形，中英文数字排版工整。","prompt_1":"模糊，水印，多手指，五官变形，"},"color":"#232","bgcolor":"#353"}],"links":[[321,203,0,208,0,"MODEL"],[430,208,0,260,0,"MODEL"],[453,266,0,203,0,"MODEL"],[466,270,0,261,0,"IMAGE"],[467,270,1,261,1,"IMAGE"],[508,113,0,266,0,"MODEL"],[464,260,0,270,0,"MODEL"],[480,83,0,270,2,"CLIP"],[481,84,0,270,3,"VAE"],[499,220,0,270,4,"IMAGE"]],"groups":[{"id":1,"title":"更多教程全网搜：机智罗_LX","bounding":[890,60,3160,940],"color":"#3f789e","flags":{"pinned":true}}],"definitions":{"subgraphs":[{"id":"7c573c25-eb6e-4205-83da-2a00874909af","version":1,"state":{"lastGroupId":1,"lastNodeId":272,"lastLinkId":514,"lastRer