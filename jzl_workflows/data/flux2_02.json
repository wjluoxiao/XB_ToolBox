idth"},"link":null},{"localized_name":"高度","name":"height","type":"INT","widget":{"name":"height"},"link":null},{"localized_name":"生成数量","name":"batch_size","type":"INT","widget":{"name":"batch_size"},"link":null},{"localized_name":"强度(小数)","name":"strength_float","type":"FLOAT","widget":{"name":"strength_float"},"link":null},{"localized_name":"强度(整数)","name":"strength_int","type":"INT","widget":{"name":"strength_int"},"link":null},{"localized_name":"倍数","name":"multiple","type":"INT","widget":{"name":"multiple"},"link":null}],"outputs":[{"localized_name":"图片宽度","name":"Image Width","type":"INT","links":[370,371]},{"localized_name":"图片高度","name":"Image Height","type":"INT","links":[368,369]},{"localized_name":"生成数量","name":"Batch Size","type":"INT","links":[367]},{"localized_name":"浮点控制","name":"Float Control","type":"FLOAT","links":[]},{"localized_name":"整数控制","name":"Int Control","type":"INT","links":[]},{"localized_name":"缩放尺寸","name":"Scale Size","type":"INT","links":[]}],"properties":{"cnr_id":"XB_ToolBox","ver":"1d9cd0bf9fe5f10b3894bc2e677e88fa62d36c9c","Node name for S&R":"XB_ImageParamsMaster","aux_id":"wjluoxiao/XB_ToolBox"},"widgets_values":["9:16 (Portrait Widescreen)",720,1280,1,1,1,16],"widgets_values_named":{"aspect_ratio":"9:16 (Portrait Widescreen)","width":720,"height":1280,"batch_size":1,"strength_float":1,"strength_int":1,"multiple":16},"color":"#16727c","bgcolor":"#4F0074"},{"id":190,"type":"CLIPTextEncode","pos":[850,830],"size":[560,1090],"flags":{"pinned":true},"order":10,"mode":0,"inputs":[{"localized_name":"clip","name":"clip","type":"CLIP","link":337},{"localized_name":"文本","name":"text","type":"STRING","widget":{"name":"text"},"link":null}],"outputs":[{"localized_name":"条件","name":"CONDITIONING","type":"CONDITIONING","slot_index":0,"links":[348]}],"title":"CLIP Text Encode (Positive Prompt)","properties":{"cnr_id":"comfy-core","ver":"0.8.2","Node name for S&R":"CLIPTextEncode","enableTabs":false,"tabWidth":65,"tabXOffset":10,"hasSecondTab":false,"secondTabText":"Send Back","secondTabOffset":80,"secondTabWidth":65},"widgets_values":["A hyper-realistic, wide-angle cinematic shot of a sprawling, dimly lit cyberpunk AI laboratory. The scene features three distinct characters and extremely complex typography integration.\n\nCharacter 1 (Foreground Center): The main female mascot wearing aerodynamic racing-style combat armor with carbon fiber textures. On her left shoulder pauldron, a curved metallic decal reads \"JZL\" matching the armor's perspective. On her chest plate, a glowing LED display clearly shows the Chinese text \"一键三连\". She is looking directly at the camera. Her skin has photorealistic pores and subtle subsurface scattering.\n\nCharacter 2 (Midground Left): A translucent, glowing blue holographic female AI assistant projecting from a terminal. She is surrounded by floating, curved UI glass panels. One holographic panel clearly displays the English text \"STATUS: ONLINE\" and another panel displays the Chinese text \"小白工具箱\" in an elegant tech font.\n\nCharacter 3 (Background Right): A heavily augmented cyborg mechanic with a robotic arm, working on a massive server rack. On the side of the server rack, industrial yellow stencil paint reads \"DANGER: 96GB VRAM\".\n\nEnvironment & Lighting Typography:\nAbove the entire scene, a massive, brilliant neon sign reads \"WIT LAUNCHER v2.0\" in bright orange, casting accurate volumetric lighting and colored reflections onto the metallic armor of Character 1. On the wet, reflective steel floor, the exact reflection of \"WIT LAUNCHER v2.0\" can be clearly seen. In the deep background, a partially obscured LED ticker tape scrolls the text \"AI-TOOLKIT\".\n\nThe text must not bleed into each other. All spelling must be flawless. 8k resolution, path-traced lighting, Unreal Engine 5 render, cinematic depth of field, masterpiece."],"widgets_values_named":{"text":"A hyper-realistic, wide-angle cinematic shot of a sprawling, dimly lit cyberpunk AI laboratory. The scene features three distinct characters and extremely complex typography integration.\n\nCharacter 1 (Foreground Center): The main female mascot wearing aerodynamic racing-style combat armor with carbon fiber textures. On her left shoulder pauldron, a curved metallic decal reads \"JZL\" matching the armor's perspective. On her chest plate, a glowing LED display clearly shows the Chinese text \"一键三连\". She is looking directly at the camera. Her skin has photorealistic pores and subtle subsurface scattering.\n\nCharacter 2 (Midground Left): A translucent, glowing blue holographic female AI assistant projecting from a terminal. She is surrounded by floating, curved UI glass panels. One holographic panel clearly displays the English text \"STATUS: ONLINE\" and another panel displays the Chinese text \"小白工具箱\" in an elegant tech font.\n\nCharacter 3 (Background Right): A heavily augmented cyborg mechanic with a robotic arm, working on a massive server rack. On the side of the server rack, industrial yellow stencil paint reads \"DANGER: 96GB VRAM\".\n\nEnvironment & Lighting Typography:\nAbove the entire scene, a massive, brilliant neon sign reads \"WIT LAUNCHER v2.0\" in bright orange, casting accurate volumetric lighting and colored reflections onto the metallic armor of Character 1. On the wet, reflective steel floor, the exact reflection of \"WIT LAUNCHER v2.0\" can be clearly seen. In the deep background, a partially obscured LED ticker tape scrolls the text \"AI-TOOLKIT\".\n\nThe text must not bleed into each other. All spelling must be flawless. 8k resolution, path-traced lighting, Unreal Engine 5 render, cinematic depth of field, masterpiece."},"color":"#232","bgcolor":"#353"},{"id":194,"type":"CLIPTextEncode","pos":[850,1970],"size":[560,150],"flags":{"pinned":true},"order":11,"mode":0,"inputs":[{"localized_name":"clip","name":"clip","type":"CLIP","link":341},{"localized_name":"文本","name":"text","type":"STRING","widget":{"name":"text"},"link":null}],"outputs