ode name for S&R":"XB_Text2ImagePromptPreset"},"widgets_values":["中文 [ZH]","无预设","","一张极具真实感的微距静物摄影。阳光透过百叶窗照在粗糙的胡桃木桌面上。桌面上放着一个透明的纯手工水晶玻璃杯，杯中装有半杯冒着密集气泡的苏打水，水面上漂浮着一片纹理清晰的青柠片。阳光穿过玻璃杯，在木桌上投射出极其逼真、绚丽的彩虹色焦散光斑（Caustics）。杯子左侧躺着一只由长绒马海毛手工缝制的小狐狸毛绒玩具，带有真实的毛刺和略微不均匀的内部填充感。狐狸脖子上挂着一块拉丝黄铜做成的复古怀表。玻璃、液体、木材、毛绒和金属的材质质感被完美分离，光影极其逼真。","",""],"widgets_values_named":{"output_lang":"中文 [ZH]","preset_mode":"无预设","three_view_text":"","internal_prompt":"一张极具真实感的微距静物摄影。阳光透过百叶窗照在粗糙的胡桃木桌面上。桌面上放着一个透明的纯手工水晶玻璃杯，杯中装有半杯冒着密集气泡的苏打水，水面上漂浮着一片纹理清晰的青柠片。阳光穿过玻璃杯，在木桌上投射出极其逼真、绚丽的彩虹色焦散光斑（Caustics）。杯子左侧躺着一只由长绒马海毛手工缝制的小狐狸毛绒玩具，带有真实的毛刺和略微不均匀的内部填充感。狐狸脖子上挂着一块拉丝黄铜做成的复古怀表。玻璃、液体、木材、毛绒和金属的材质质感被完美分离，光影极其逼真。","manager_settings":"","xb_image_preset":""},"color":"#16727c","bgcolor":"#4F0074"}],"links":[[377,209,0,205,0,"IMAGE"],[382,210,0,209,20,"STRING"]],"groups":[{"id":2,"title":"更多教程全网搜：机智罗_LX","bounding":[390,760,1980,950],"color":"#3f789e","flags":{"pinned":true}}],"definitions":{"subgraphs":[{"id":"af1a4f1a-3857-42b9-b62d-3e7790ebad60","version":1,"state":{"lastGroupId":2,"lastNodeId":211,"lastLinkId":403,"lastRerouteId":0},"revision":0,"config":{},"name":"New Subgraph","inputNode":{"id":-10,"bounding":[80,1430,128,468]},"outputNode":{"id":-20,"bounding":[1870,1426,128,68]},"inputs":[{"id":"9e9cf2c5-7e5c-4ae5-b8ae-5860587ec653","name":"unet_name","type":"COMBO","linkIds":[383],"label":"主模型","pos":[184,1454]},{"id":"bbd97f9d-5674-425b-970f-bdb40b99b99e","name":"clip_name","type":"COMBO","linkIds":[384],"label":"CLIP","pos":[184,1474]},{"id":"dd5f67e5-cb19-4bba-9389-66dbddb09b92","name":"vae_name","type":"COMBO","linkIds":[403],"label":"VAE","pos":[184,1494]},{"id":"a10b308f-9199-4066-bba2-0b79e7da3a04","name":"lora_01","type":"COMBO","linkIds":[386],"pos":[184,1514]},{"id":"aaabc55f-c693-4fcc-9a32-43f2e783516c","name":"strength_01","type":"FLOAT","linkIds":[387],"pos":[184,1534]},{"id":"a8c88ba5-8004-43df-9cf2-8210480f51ef","name":"lora_02","type":"COMBO","linkIds":[388],"pos":[184,1554]},{"id":"fac1a8d4-8599-41af-878c-